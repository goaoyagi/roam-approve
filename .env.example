# URL the adapter / hooks use to reach the Bridge
ROAM_BRIDGE_URL=http://127.0.0.1:8000
# Address the Bridge binds to (127.0.0.1 = localhost only; set 0.0.0.0 to expose on LAN)
ROAM_BIND=127.0.0.1
# Port the Bridge listens on
ROAM_PORT=8000
# MQTT broker host
ROAM_MQTT_HOST=127.0.0.1
# MQTT broker port
ROAM_MQTT_PORT=1883
# Notifier backend: mqtt (or memory for tests)
ROAM_NOTIFIER=mqtt
# Seconds the hook waits for a device decision (default 240, clamped to 280 max;
# must stay below the hooks.v1.json timeout=300 including ~20s HTTP margin)
ROAM_WAIT_S=240
# Bearer token used by adapters/hooks (agent side). Generate with `make gen-tokens`
ROAM_AGENT_TOKEN=changeme-run-make-gen-tokens
# Bearer token used by the device/simulator (device side). Generate with `make gen-tokens`
ROAM_DEVICE_TOKEN=changeme-run-make-gen-tokens
